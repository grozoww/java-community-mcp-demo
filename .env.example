# Copy to .env (or export in your shell) before starting the MCP GitHub server.
#
# Fine-grained personal access token, scoped to the ONE demo repository.
# Required permissions: Contents: Read and write, Pull requests: Read and write,
# Issues: Read and write, Metadata: Read-only.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# The repository the agent is allowed to touch. Anything else is rejected by the
# server-side allow-list, no matter what the model asks for.
DEMO_GITHUB_OWNER=your-github-user
DEMO_GITHUB_REPO=mcp-java-community

# Set to true only when you are ready to let the agent open branches and PRs.
DEMO_GITHUB_WRITE_ENABLED=true
